{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mobile:customer:build": "ng build customer-app --configuration mobile",
    "mobile:customer:sync": "npm run mobile:customer:build && cd mobile-customer && npx cap sync android",
    "mobile:customer:open": "cd mobile-customer && npx cap open android",
    "mobile:customer:run": "npm run mobile:customer:sync && cd mobile-customer && npx cap run android",
    "mobile:delivery:build": "ng build delivery-app --configuration mobile",
    "mobile:delivery:sync": "npm run mobile:delivery:build && cd mobile-delivery && npx cap sync android",
    "mobile:delivery:open": "cd mobile-delivery && npx cap open android",
    "mobile:delivery:run": "npm run mobile:delivery:sync && cd mobile-delivery && npx cap run android"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/google-maps": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@capacitor/cli": "^6.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2"
  }
}
