# Stage 1: Build the Angular applications
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
COPY packages /packages
RUN npm install

COPY frontend/ .
RUN npm run build:packages

# runtime-config.js is intentionally gitignored because it can contain
# deployment-specific browser config. Generate it before Angular copies assets.
ARG GOOGLE_MAPS_API_KEY=""
ARG GOOGLE_MAPS_MAP_ID=""
ENV GOOGLE_MAPS_API_KEY=$GOOGLE_MAPS_API_KEY
ENV GOOGLE_MAPS_MAP_ID=$GOOGLE_MAPS_MAP_ID
RUN node scripts/write-runtime-config.mjs

# Build all applications with their respective base hrefs
RUN npx ng build customer-app --configuration production
RUN npx ng build admin-panel --configuration production
RUN npx ng build vendor-app --configuration production
RUN npx ng build delivery-app --configuration production

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config (make sure to provide it via docker-compose volume or copy it here)
# We will volume mount it in docker-compose.prod.yml

# Copy built artifacts into Nginx. We place them naturally under /sa/ folders to match Nginx URIs natively
COPY --from=build /app/dist/customer-app/browser /usr/share/nginx/html/sa
COPY --from=build /app/dist/admin-panel/browser /usr/share/nginx/html/sa/admin
COPY --from=build /app/dist/vendor-app/browser /usr/share/nginx/html/sa/vendor
COPY --from=build /app/dist/delivery-app/browser /usr/share/nginx/html/sa/delivery
COPY frontend/docker/runtime-config-entrypoint.sh /docker-entrypoint-runtime-config.sh
RUN chmod +x /docker-entrypoint-runtime-config.sh

EXPOSE 80
CMD ["/docker-entrypoint-runtime-config.sh"]
